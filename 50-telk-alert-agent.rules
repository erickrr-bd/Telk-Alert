// /etc/polkit-1/rules.d/50-telk-alert-agent.rules
// Allows the telk_alert user (Telk-Alert-Agent) to RESTART telk-alert.service, and nothing else.
// Telk-Alert-Agent calls "systemctl --no-ask-password restart -- telk-alert.service".
polkit.addRule(function(action, subject) {
	if (action.id == "org.freedesktop.systemd1.manage-units" &&
		action.lookup("unit") == "telk-alert.service" &&
		action.lookup("verb") == "restart" &&
		subject.user == "telk_alert") {
		return polkit.Result.YES;
	}
});
